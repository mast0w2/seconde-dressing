# ============================================================================
# Seconde Dressing - Configuration Example
# ============================================================================
# Copy this file to .env.local and fill in your actual values
# DO NOT commit .env.local to version control
# ============================================================================

# ============================================================================
# SUPABASE CONFIGURATION (Required)
# ============================================================================
# Three environments, two Supabase projects:
#   * local (npm run dev)  -> PREPROD project  iqwmcbbbgmdjmhjptovg
#   * Vercel Preview       -> PREPROD project  iqwmcbbbgmdjmhjptovg
#   * Vercel Production    -> PROD project     jqjqcgsjkaqsyejfpdco
# Never point a local .env.local at production.
# Preprod holds a copy of production data: refresh it with
# `npm run db:sync-preprod` (see scripts/sync-preprod.mjs).
# ============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://iqwmcbbbgmdjmhjptovg.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_rVfdlEPb6-v6ji0cDDn2_A_IqqZcJO2

# ----------------------------------------------------------------------------
# EMAIL REDIRECT (Required outside production)
# ----------------------------------------------------------------------------
# Preprod contains real customer addresses. Every email is sent to this
# address instead, with the intended recipient in the subject. Set on Vercel
# Preview too; never on Production.
# ----------------------------------------------------------------------------
EMAIL_REDIRECT_TO=you+preprod@example.com

# ----------------------------------------------------------------------------
# SUPABASE SERVICE ROLE (Required for auth emails)
# ----------------------------------------------------------------------------
# Settings > API > service_role secret.
#
# Sert uniquement côté serveur, à fabriquer les liens de connexion et de
# confirmation d'inscription pour les envoyer ensuite via Brevo. Sans elle,
# l'application retombe sur le mailer intégré de Supabase, plafonné à deux
# envois par heure : la plupart des emails ne partent jamais.
#
# NE JAMAIS exposer cette clé au navigateur (pas de préfixe NEXT_PUBLIC_).
# ----------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ============================================================================
# BREVO (SENDINBLUE) EMAIL SERVICE CONFIGURATION
# ============================================================================
# Required for sending transactional emails
# Get your API key from: https://app.brevo.com/settings/keys/api
# ============================================================================
BREVO_API_KEY=your_brevo_smtp_api_key
EMAIL_FROM="Seconde <support@seconde-dressing.com>"
# Adresse qui reçoit les réponses des clientes (par défaut : celle de EMAIL_FROM)
EMAIL_REPLY_TO=support@seconde-dressing.com

# ============================================================================
# CONTACT FORM ADMIN NOTIFICATION
# ============================================================================
# Email address to receive contact form submissions
# This email will receive a copy of all contact form messages
# ============================================================================
CONTACT_ADMIN_EMAILS=your-admin-email@example.com

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================
# Your application's public URL
# Use localhost:3000 for development
# Use your production domain for production
# ============================================================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production: https://www.seconde-dressing.com (with www: the bare domain
# redirects there, and canonical URLs must not point to a redirect).

# ============================================================================
# OPTIONAL: Database Connection Pooling (Advanced)
# ============================================================================
# Uncomment and configure if you need connection pooling
# SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# ============================================================================
# SECRETS: never prefix them with NEXT_PUBLIC_
# ============================================================================
# Anything named NEXT_PUBLIC_* is copied into the JavaScript sent to every
# visitor. Only the Supabase URL and its publishable key may be public (the
# database is protected by RLS). Brevo, service role and any other secret
# stay server-side; the modules reading them import "server-only".
