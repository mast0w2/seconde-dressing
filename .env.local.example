# ============================================================================
# Seconde Dressing - Configuration Example
# ============================================================================
# Copy this file to .env.local and fill in your actual values
# DO NOT commit .env.local to version control
# ============================================================================

# ============================================================================
# SUPABASE CONFIGURATION (Required)
# ============================================================================
# Get these values from your Supabase project dashboard:
# 1. Go to https://supabase.com/dashboard
# 2. Select your project
# 3. Navigate to Settings > API
# ============================================================================
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# ============================================================================
# BREVO (SENDINBLUE) EMAIL SERVICE CONFIGURATION
# ============================================================================
# Required for sending transactional emails
# Get your API key from: https://app.brevo.com/settings/keys/api
# ============================================================================
BREVO_API_KEY=your_brevo_smtp_api_key
EMAIL_FROM="Seconde Dressing <no-reply@your-domain.com>"

# ============================================================================
# CONTACT FORM ADMIN NOTIFICATION
# ============================================================================
# Email address to receive contact form submissions
# This email will receive a copy of all contact form messages
# ============================================================================
CONTACT_ADMIN_EMAIL=your-admin-email@example.com

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================
# Your application's public URL
# Use localhost:3000 for development
# Use your production domain for production
# ============================================================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ============================================================================
# OPTIONAL: Database Connection Pooling (Advanced)
# ============================================================================
# Uncomment and configure if you need connection pooling
# SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# ============================================================================
# OPTIONAL: JWT Configuration (Advanced)
# ============================================================================
# Uncomment to customize JWT settings
# NEXT_PUBLIC_JWT_SECRET=your_jwt_secret
# JWT_EXPIRY=3600
